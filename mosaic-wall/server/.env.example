# Copy to .env and fill in. Never commit .env.

# --- Higgsfield (https://docs.higgsfield.ai). Format: KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# higgsfield = real API. mock = local ffmpeg push-in on the photo, no API calls (for rehearsing Steps 2, 4, 5).
GEN_PROVIDER=higgsfield
# Which entry of models.json to use. Switch here if a model is slow or down.
GEN_MODEL=dop-turbo
# Jobs generating at the same time.
MAX_CONCURRENCY=3
# Give up on one attempt after this many seconds (the job then retries once).
GEN_TIMEOUT_S=300
POLL_INTERVAL_MS=3000

# --- Server
PORT=3000
# HTTPS is needed for the iPad camera (Safari blocks getUserMedia on plain http). Run: npm run cert
HTTPS_PORT=3443
# Address printed in the QR code. Leave empty to auto-detect the MacBook's LAN IP, e.g. http://192.168.1.20:3000
PUBLIC_BASE_URL=
# Operator page only answers on the MacBook itself (http://localhost:3000/operator). Set false to open it to the LAN.
OPERATOR_LOCAL_ONLY=true
# Shown on the thank-you screen so guests join the right network before scanning. Leave empty to hide.
WIFI_NAME=
# Jobs allowed to wait at once. Beyond this the iPad asks the guest to try again in a minute.
MAX_QUEUE=30
# Guest data is deleted after this many days by: npm run purge
RETENTION_DAYS=7

# --- Mock provider only
MOCK_SECONDS=5
MOCK_FAIL_RATE=0
